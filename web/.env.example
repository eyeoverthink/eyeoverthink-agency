# Firebase AI Logic hybrid edge tier (optional — the agency runs fully on local Ollama without it).
# Copy to web/.env.local and fill from Firebase console > Project settings > Your apps (web app).
# Use the Gemini Developer API (Spark plan, no billing) for a $0 setup.
# Docs: https://firebase.google.com/docs/ai-logic/hybrid/web/get-started
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Public reCAPTCHA site key for Firebase App Check (required by Firebase AI Logic).
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY
# recaptcha-enterprise (default) or recaptcha-v3
VITE_APPCHECK_PROVIDER=recaptcha-enterprise
# Localhost only: prints an App Check debug token in the console to safelist. Never commit a token string.
VITE_APPCHECK_DEBUG=true
# Cloud fallback model for IN_CLOUD inference
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
